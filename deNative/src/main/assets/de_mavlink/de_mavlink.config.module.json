                        "pid_d": 0.5,
                        "ff_scale": 200.0,
                        "max_accel": 2.5,
                        "max_rate": 1.2,
                        "deadband": 0.001,
                        "integral_limit": 100.0,
                        "output_limit": 500.0
                    }
                }
            }
        }
