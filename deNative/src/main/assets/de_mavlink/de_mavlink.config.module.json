    "read_only_mode": false,
    // Saved cloud tasks (geofences, missions) are reloaded only on the first
    // comm-server registration after boot; a link flap in flight must not
    // replay a stale cloud mission. Set true to restore the old
    // reload-on-every-reconnect behaviour.
    "reload_tasks_on_every_reconnect": false,
    // Precision-landing safety gate: de_mavlink converts de_precland's semantic
    // PRECLAND_TARGET (6537) into MAVLink LANDING_TARGET only when armed, in an
    // allowed mode, target is fresh, and the tracker is not controlling.
    "precland": {
        "enabled": false,
        "allowed_modes": [12, 2],       // VEHICLE_MODE_LAND, VEHICLE_MODE_RTL
        "allow_auto_land": true,        // missions fly nav steps in AUTO(5): also emit while the FC's current mission item is a MAV_CMD_NAV_LAND - waypoint legs never feed the FC
        "max_target_age_ms": 300,
        "max_send_hz": 10,
        "min_tags": 1,
        "frame": 12                     // MAV_FRAME_BODY_FRD - the only frame ArduPilot accepts for this vector; other values are ignored
    },
    // P3-05: "payload.release" through the FC gripper (MAV_CMD_DO_GRIPPER).
    // Off unless set. ArduPilot needs GRIP_ENABLE=1 and GRIP_TYPE (1 servo,
    // 2 EPM); the release result is ok only on MAV_RESULT_ACCEPTED (3 s ack).
    // droneengage_rpi_gpio can provide "payload" from a pin pulse instead
    // ("payload_release") - configure only one: when both advertise, the
    // communicator keeps the first and warns.
    // EV-PAY: "payload_bays" names several grippers - each entry adds a
    // payload.<key> action on its gripper instance; a missing "instance"
    // inherits gripper_instance. Absent = the single bay "main".
    // "payload_provider": "fc_gripper",
    // "gripper_instance": 1,
    // "payload_bays": [ { "key": "left", "instance": 1 }, { "key": "right", "instance": 2 } ],
    "geo_projection": {
        "enabled": false,               // project AI best-object boxes (1078) to the ground; fire detect.detected
        // "camera_registry": "camera_registry.json",  // per-unit cam_id table; when set it is
        //                                            // authoritative - unknown cam_id obs are dropped
        "hfov_deg": 62.2,
        "vfov_deg": 48.8,
        "mount_pitch_deg": -90,         // -90 = camera looking straight down
        "mount_yaw_deg": 0,
        "mount_roll_deg": 0,
        "latency_ms": 150,              // pose lag between video frame and this bus
        "min_conf": 0.6,
        "rate_hz": 1,                   // max detect.detected events per class per second
        "sigma_att_deg": 2.0,           // 1-sigma attitude error used for unc_m
        "sigma_alt_m": 2.0              // 1-sigma altitude error used for unc_m
    },
    "s2s_udp_listening_ip": "127.0.0.1",
    "s2s_udp_listening_port": "61003",
    "s2s_udp_packet_size": "8192",
    "s2s_udp_target_ip": "127.0.0.1",
    "s2s_udp_target_port": "60000",
    "udp_proxy_enabled": true,
    "use_unix_socket": true   // SHOULD BE FALSE when Multiple DE_COMM modules are running on the same board.
}