{
    "default_optimization_level": 2,
    // AUTO level (4) tuning: a send() taking longer than stall_us counts as a
    // stall; up_after_stalls consecutive stalls raise the effective level by 1;
    // down_after_ms[level] is the dwell time of clean sends before stepping
    // down one level (same style as message_timeouts). AUTO starts at
    // start_level and never dwells below min_level.
    "auto_optimization": {
        "stall_us": 20000,
        "up_after_stalls": 4,
        "down_after_ms": [
            0,
            5000,
            10000,
            20000
        ],
        "min_level": 1,
        "start_level": 2
    },
    "event_fire_channel": 16,
    "event_wait_channel": 15,
    // "fcb_connection_uri": {
    //     "ip": "0.0.0.0",
    //     "port": 5760,
    //     "type": "tcp"
    // },
    "fcb_connection_uri": {
        "ip": "127.0.0.1",
        "port": 5760,
        "type": "tcp"
    },
    "logger_debug": false,
    "logger_enabled": true,
    "tlog_enabled": false,
