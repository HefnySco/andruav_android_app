                        "pid_d": 0.05,
                        "ff_scale": 200.0,
                        "max_accel": 2.5,
                        "max_rate": 1.2,
                        "deadband": 0.025,
                        "integral_limit": 100.0,
                        "output_limit": 500.0
                    }
                },
                "standing": {
                    "x_axis": {
                        "pid_p": 10.0,
                        "pid_i": 1.5,
                        "pid_d": 0.05,
                        "ff_scale": 400.0,
                        "max_accel": 0.8,
                        "max_rate": 0.15,
                        "deadband": 0.001,
                        "integral_limit": 200.0,
                        "output_limit": 500.0
                    },
                    "yz_axis": {
                        "pid_p": 10.0,
                        "pid_i": 1.5,
                        "pid_d": 0.05,
                        "ff_scale": 400.0,
                        "max_accel": 0.8,
                        "max_rate": 0.15,
                        "deadband": 0.001,
                        "integral_limit": 200.0,
                        "output_limit": 500.0
