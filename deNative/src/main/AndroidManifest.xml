<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".DeCommService"
            android:process=":de_comm"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the DroneEngage de_comm module in its own process on the device." />
        </service>
        <service
            android:name=".DeMavlinkService"
            android:process=":de_mavlink"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the DroneEngage de_mavlink module in its own process on the device." />
        </service>
        <activity
            android:name=".DeNativeDebugActivity"
            android:exported="true" />
    </application>
</manifest>
