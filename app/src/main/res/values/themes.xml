<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme.Andruav variants (AN-0145). Dark maps every attribute to the
         home_* value it replaces, so the screens look exactly as before.
         Light and Sun (later tasks) override the same attributes. -->
    <style name="Theme.Andruav" parent="AppTheme" />

    <style name="Theme.Andruav.Dark">
        <!-- AN-0150: same preferenceTheme the manifest SettingsTheme used, so
             settings under Dark look exactly as before. -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <item name="deBg">@color/home_bg</item>
        <item name="deSurface">@color/home_surface</item>
        <item name="deSurfaceMuted">@color/home_surface_disabled_tile</item>
        <item name="deInputBg">@color/home_bg</item>
        <item name="deSheetBg">@color/home_popup_bg</item>
        <item name="deScrim">@color/home_scrim</item>

        <item name="deBorder">@color/home_border</item>
        <item name="deBorderSoft">@color/home_border_soft</item>
        <item name="deBorderInput">@color/home_border_input</item>
        <item name="deBorderWidth">1dp</item>
        <item name="deBorderWidthStrong">1.5dp</item>
        <item name="deTabUnderlineWidth">3dp</item>

        <item name="deTextPrimary">@color/home_text_primary</item>
        <item name="deTextSecondary">@color/home_text_secondary</item>
        <item name="deTextDim">@color/home_text_dim</item>
        <item name="deTextDimAlt">@color/home_text_dim_alt</item>
        <item name="deTextDimDarker">@color/home_text_dim_darker</item>
        <item name="deTextOnInput">@color/home_text_on_input</item>

        <item name="deAccent">@color/home_amber</item>
        <item name="deOnAccent">@color/home_amber_on</item>
        <item name="deAccentText">@color/home_amber</item>
        <item name="deWarnBorder">@color/home_amber_warning_border</item>
        <item name="deBtnAmberBorder">@android:color/transparent</item>
        <item name="deBtnAmberBorderWidth">0dp</item>

        <item name="deBlueIcon">@color/home_blue_icon</item>
        <item name="deBlueBorder">@color/home_blue_border</item>
        <item name="deBlueBg">@color/home_blue_bg</item>
        <item name="deGood">@color/home_green_icon</item>
        <item name="deGoodBorder">@color/home_green_border</item>
        <item name="deGoodBg">@color/home_green_bg</item>
        <item name="deBad">@color/home_red_dot</item>
        <item name="deBadText">@color/home_red_text</item>
        <item name="deBadBorderSoft">@color/home_red_border_soft</item>

        <item name="deIconMuted">@color/home_icon_muted</item>
        <item name="deIconGray">@color/home_icon_gray</item>
        <item name="deSwitchOff">@color/home_border_input</item>
    </style>

    <style name="Theme.Andruav.Dark.NoActionBar" parent="Theme.Andruav.Dark">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- AN-0148: Light maps every attribute to the light_* palette from the
         mockup (.light). Dim text and green are darker than the mockup so
         all body text reaches 4.5:1 (D-0032). -->
    <style name="Theme.Andruav.Light" parent="Theme.Andruav.Dark">
        <item name="deBg">@color/light_bg</item>
        <item name="deSurface">@color/light_surface</item>
        <item name="deSurfaceMuted">@color/light_surface_muted</item>
        <item name="deInputBg">@color/light_bg</item>
        <item name="deSheetBg">@color/light_sheet_bg</item>
        <item name="deScrim">@color/light_scrim</item>

        <item name="deBorder">@color/light_border</item>
        <item name="deBorderSoft">@color/light_border_soft</item>
        <item name="deBorderInput">@color/light_border_input</item>
        <item name="deBorderWidth">1dp</item>
        <item name="deBorderWidthStrong">1.5dp</item>
        <item name="deTabUnderlineWidth">3dp</item>

        <item name="deTextPrimary">@color/light_text_primary</item>
        <item name="deTextSecondary">@color/light_text_secondary</item>
        <item name="deTextDim">@color/light_text_dim</item>
        <item name="deTextDimAlt">@color/light_text_dim_alt</item>
        <item name="deTextDimDarker">@color/light_text_dim_darker</item>
        <item name="deTextOnInput">@color/light_text_on_input</item>

        <item name="deAccent">@color/light_amber</item>
        <item name="deOnAccent">@color/light_amber_on</item>
        <item name="deAccentText">@color/light_accent_text</item>
        <item name="deWarnBorder">@color/light_amber_warning_border</item>
        <item name="deBtnAmberBorder">@android:color/transparent</item>
        <item name="deBtnAmberBorderWidth">0dp</item>

        <item name="deBlueIcon">@color/light_blue_icon</item>
        <item name="deBlueBorder">@color/light_blue_border</item>
        <item name="deBlueBg">@color/light_blue_bg</item>
        <item name="deGood">@color/light_good</item>
        <item name="deGoodBorder">@color/light_good_border</item>
        <item name="deGoodBg">@color/light_good_bg</item>
        <item name="deBad">@color/light_bad</item>
        <item name="deBadText">@color/light_bad_text</item>
        <item name="deBadBorderSoft">@color/light_bad_border_soft</item>

        <item name="deIconMuted">@color/light_icon_muted</item>
        <item name="deIconGray">@color/light_icon_gray</item>
        <item name="deSwitchOff">@color/light_switch_off</item>

        <!-- AN-0150: standard attrs so settings and dialogs pick up the
             Light palette - amber accent instead of the stock teal. -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Light</item>
        <item name="colorAccent">@color/light_amber</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Light</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/light_status_bar</item>
    </style>

    <!-- AN-0149: Sun maps every attribute to the sun_* palette from the
         mockup (.sun) - maximum contrast for direct sunlight: black text
         on white, 2 dp black borders, no grey secondary text, dark green
         and dark red for state. The widget default styles below make the
         text one weight bolder: regular text moves to sans-serif-medium
         where a layout does not set its own fontFamily. -->
    <style name="Theme.Andruav.Sun" parent="Theme.Andruav.Dark">
        <item name="deBg">@color/sun_bg</item>
        <item name="deSurface">@color/sun_surface</item>
        <item name="deSurfaceMuted">@color/sun_surface_muted</item>
        <item name="deInputBg">@color/sun_bg</item>
        <item name="deSheetBg">@color/sun_sheet_bg</item>
        <item name="deScrim">@color/sun_scrim</item>

        <item name="deBorder">@color/sun_border</item>
        <item name="deBorderSoft">@color/sun_border_soft</item>
        <item name="deBorderInput">@color/sun_border_input</item>
        <item name="deBorderWidth">2dp</item>
        <item name="deBorderWidthStrong">2.5dp</item>
        <item name="deTabUnderlineWidth">4dp</item>

        <item name="deTextPrimary">@color/sun_text_primary</item>
        <item name="deTextSecondary">@color/sun_text_secondary</item>
        <item name="deTextDim">@color/sun_text_dim</item>
        <item name="deTextDimAlt">@color/sun_text_dim_alt</item>
        <item name="deTextDimDarker">@color/sun_text_dim_darker</item>
        <item name="deTextOnInput">@color/sun_text_on_input</item>

        <item name="deAccent">@color/sun_amber</item>
        <item name="deOnAccent">@color/sun_amber_on</item>
        <item name="deAccentText">@color/sun_accent_text</item>
        <item name="deWarnBorder">@color/sun_amber_warning_border</item>
        <item name="deBtnAmberBorder">@color/sun_border</item>
        <item name="deBtnAmberBorderWidth">2dp</item>

        <item name="deBlueIcon">@color/sun_blue_icon</item>
        <item name="deBlueBorder">@color/sun_blue_border</item>
        <item name="deBlueBg">@color/sun_blue_bg</item>
        <item name="deGood">@color/sun_good</item>
        <item name="deGoodBorder">@color/sun_good_border</item>
        <item name="deGoodBg">@color/sun_good_bg</item>
        <item name="deBad">@color/sun_bad</item>
        <item name="deBadText">@color/sun_bad_text</item>
        <item name="deBadBorderSoft">@color/sun_bad_border_soft</item>

        <item name="deIconMuted">@color/sun_icon_muted</item>
        <item name="deIconGray">@color/sun_icon_gray</item>
        <item name="deSwitchOff">@color/sun_switch_off</item>

        <!-- AN-0150: standard attrs so settings and dialogs read black on
             white with strong black dividers and black-bordered checkboxes. -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Sun</item>
        <item name="colorAccent">@color/sun_amber</item>
        <item name="android:windowBackground">@color/sun_bg</item>
        <item name="android:textColorPrimary">@color/sun_text_primary</item>
        <item name="android:textColorSecondary">@color/sun_text_secondary</item>
        <item name="checkboxStyle">@style/Widget.Andruav.Sun.CheckBox</item>
        <item name="android:checkboxStyle">@style/Widget.Andruav.Sun.CheckBox</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Light</item>

        <item name="android:textViewStyle">@style/Widget.Andruav.Sun.TextView</item>
        <item name="android:buttonStyle">@style/Widget.Andruav.Sun.Button</item>
        <item name="buttonStyle">@style/Widget.Andruav.Sun.Button</item>
        <item name="android:editTextStyle">@style/Widget.Andruav.Sun.EditText</item>
        <item name="editTextStyle">@style/Widget.Andruav.Sun.EditText</item>

        <item name="android:textAppearance">@style/TextAppearance.Andruav.Sun</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Andruav.Sun.Small</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Andruav.Sun</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Andruav.Sun.Large</item>
        <item name="android:textAppearanceButton">@style/TextAppearance.Andruav.Sun.Button</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/sun_status_bar</item>
    </style>

    <style name="Widget.Andruav.Sun.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Andruav.Sun.Button" parent="Widget.AppCompat.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Andruav.Sun.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Andruav.Sun" parent="android:TextAppearance">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Andruav.Sun.Small">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Andruav.Sun.Large">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Andruav.Sun.Button">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Theme.Andruav.Light.NoActionBar" parent="Theme.Andruav.Light">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Andruav.Sun.NoActionBar" parent="Theme.Andruav.Sun">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
