<resources>
    <declare-styleable name="SwipeNumberPicker">
        <attr name="min" format="integer"/>
        <attr name="max" format="integer"/>
        <attr name="value" format="integer"/>
        <attr name="arrowColor" format="color"/>
        <attr name="backgroundColor" format="color"/>
        <attr name="numberColor" format="color"/>
    </declare-styleable>

    <style name="DialogFragmentStyle" parent="@android:style/Theme.Dialog">
        <item name="android:windowSoftInputMode">stateHidden|adjustResize</item>
    </style>


    <!-- No Header Dialog -->

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- AN-0144: the default light bottom-sheet background showed white
             tips behind the dark sheets' rounded corners. Transparent frame. -->
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialog</item>
        <!-- AN-0150: dialogs keep one dark-navy look in every theme -->
        <item name="alertDialogTheme">@style/Theme.Andruav.DialogAlert.AppCompat</item>
        <item name="android:alertDialogTheme">@style/Theme.Andruav.DialogAlert</item>
        <item name="dialogTheme">@style/Theme.Andruav.Dialog.AppCompat</item>
        <item name="android:dialogTheme">@style/Theme.Andruav.Dialog</item>
    </style>

    <style name="AppBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalBottomSheet</item>
    </style>

    <style name="AppModalBottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Theme for PreferenceFragmentCompat-based settings activities.
         AppCompat themes do not include preferenceTheme, so we overlay it here. -->
    <style name="SettingsTheme" parent="AppTheme">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <!-- AN-0150: preferenceTheme variants the Theme.Andruav.* styles point
         at. Dark keeps the stock PreferenceThemeOverlay so settings look
         exactly as before; Light gets a light-grey divider; Sun gets a 2 dp
         black divider and black category titles. -->
    <style name="PreferenceThemeOverlay.Light" parent="PreferenceThemeOverlay">
        <item name="preferenceFragmentCompatStyle">@style/PreferenceFragment.Andruav.Light</item>
        <item name="preferenceFragmentStyle">@style/PreferenceFragment.Andruav.Light</item>
        <item name="preferenceCategoryTitleTextColor">@color/light_accent_text</item>
    </style>

    <style name="PreferenceFragment.Andruav.Light" parent="PreferenceFragment.Material">
        <item name="android:divider">@color/light_border</item>
    </style>

    <style name="PreferenceThemeOverlay.Sun" parent="PreferenceThemeOverlay">
        <item name="preferenceFragmentCompatStyle">@style/PreferenceFragment.Andruav.Sun</item>
        <item name="preferenceFragmentStyle">@style/PreferenceFragment.Andruav.Sun</item>
        <item name="preferenceCategoryTitleTextColor">@color/sun_text_primary</item>
    </style>

    <!-- AN-0150: Dark gets its own preference screen now (human decision
         after the first submission) - the stock overlay drew a light page,
         so Dark and Light both showed white settings. home_* divider and
         amber category titles match the Dark palette. -->
    <style name="PreferenceThemeOverlay.AndruavDark" parent="PreferenceThemeOverlay">
        <item name="preferenceFragmentCompatStyle">@style/PreferenceFragment.Andruav.Dark</item>
        <item name="preferenceFragmentStyle">@style/PreferenceFragment.Andruav.Dark</item>
        <item name="preferenceCategoryTitleTextColor">@color/home_amber</item>
    </style>

    <style name="PreferenceFragment.Andruav.Dark" parent="PreferenceFragment.Material">
        <item name="android:divider">@color/home_border</item>
    </style>

    <!-- AN-0150: app dialogs are theme-independent - the same dark navy
         card everywhere (like the About dialog). framework dialogs
         (android.app.AlertDialog / android.app.Dialog) resolve
         android:alertDialogTheme / android:dialogTheme and need a
         framework dialog theme - an AppCompat parent leaves the window
         white. AppCompat dialogs resolve alertDialogTheme / dialogTheme
         and need the AppCompat parents. Both get the About card's navy
         background, light text and amber accent. -->
    <style name="Theme.Andruav.DialogAlert" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_card_bg</item>
        <item name="android:textColorPrimary">@color/home_text_primary</item>
        <item name="android:textColorSecondary">@color/home_text_secondary</item>
        <item name="android:colorAccent">@color/home_amber</item>
        <item name="colorAccent">@color/home_amber</item>
    </style>

    <style name="Theme.Andruav.DialogAlert.AppCompat" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/home_amber</item>
        <item name="colorBackgroundFloating">@color/card_surface</item>
        <item name="android:textColorPrimary">@color/home_text_primary</item>
        <item name="android:textColorSecondary">@color/home_text_secondary</item>
        <item name="textColorAlertDialogListItem">@color/home_text_primary</item>
    </style>

    <style name="Theme.Andruav.Dialog" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@drawable/dialog_card_bg</item>
        <item name="android:textColorPrimary">@color/home_text_primary</item>
        <item name="android:textColorSecondary">@color/home_text_secondary</item>
        <item name="android:colorAccent">@color/home_amber</item>
        <item name="colorAccent">@color/home_amber</item>
    </style>

    <style name="Theme.Andruav.Dialog.AppCompat" parent="Theme.AppCompat.Dialog">
        <item name="colorAccent">@color/home_amber</item>
        <item name="colorBackgroundFloating">@color/card_surface</item>
        <item name="android:textColorPrimary">@color/home_text_primary</item>
        <item name="android:textColorSecondary">@color/home_text_secondary</item>
    </style>

    <style name="PreferenceFragment.Andruav.Sun" parent="PreferenceFragment.Material">
        <item name="android:divider">@color/sun_border</item>
        <item name="android:dividerHeight">2dp</item>
    </style>

    <style name="Widget.Andruav.Sun.CheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/sun_border</item>
    </style>

    <!-- AN-0150: action-bar overlays for Theme.Andruav.Light/.Sun.
         ThemeOverlay.AppCompat.Light darkens the title, but the bar
         background still comes from colorPrimary (dark) - that is the
         black-on-black "Settings" title. The overlays force a light bar. -->
    <style name="ThemeOverlay.Andruav.Light.ActionBar" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorPrimary">@color/light_surface</item>
    </style>

    <style name="ThemeOverlay.Andruav.Sun.ActionBar" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorPrimary">@color/sun_bg</item>
        <item name="android:textColorPrimary">@android:color/black</item>
    </style>


    <style name="generalNumberSpinner">
        <item name="android:fontFamily">sans-serif-condensed</item>

    </style>


    <style name="generalLabelTitle">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@color/btn_TXT_BLUE_DARKEST</item>
    </style>


    <style name="commentText">
        <item name="android:textColor">@color/btn_TXT_GREY_DARK</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">italic</item>

    </style>

    <style name="widgetandnruavinfoText">
        <item name="android:textSize">@dimen/info_bar_text_size</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>


    <style name="GamePadValueBar">
        <item name="android:layout_marginLeft">5dp</item>
    </style>

    <style name="GamePadChannelNames">
        <item name="android:layout_marginLeft">5dp</item>
        <item name="android:width">40dp</item>
    </style>

</resources>
