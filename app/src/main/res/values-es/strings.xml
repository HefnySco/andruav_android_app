    <!-- MAVLink command result descriptions -->
    <string name="mav_result_succeeded">conseguido</string>
    <string name="mav_result_temporarily_rejected">El comando es válido, pero no se puede ejecutar en este momento. Se utiliza para indicar un problema que se solucionará simplemente esperando (p. ej. una máquina de estados está ocupada, no se puede armar porque no se ha obtenido el fix GPS, etc.). Reintentarlo más tarde debería funcionar.</string>
    <string name="mav_result_denied">El comando no es válido (es compatible pero tiene parámetros no válidos). Reintentar el mismo comando y parámetros no funcionará.</string>
    <string name="mav_result_unsupported">El comando no es compatible (desconocido).</string>
    <string name="mav_result_failed">El comando es válido, pero su ejecución ha fallado. Se utiliza para indicar cualquier problema no temporal o inesperado, es decir, cualquier problema que deba solucionarse antes de que el comando pueda tener éxito o reintentarse. Por ejemplo, intentar escribir un archivo sin memoria disponible, intentar armar cuando los sensores no están calibrados, etc.</string>
    <string name="mav_result_in_progress">El comando es válido y se está ejecutando. Esto irá seguido de más actualizaciones de progreso, es decir, el componente puede enviar más mensajes COMMAND_ACK con el resultado MAV_RESULT_IN_PROGRESS (a una tasa decidida por la implementación), y debe terminar enviando un mensaje COMMAND_ACK con el resultado final de la operación. El campo COMMAND_ACK.progress se puede usar para indicar el progreso de la operación. No es necesario que el remitente reintente el comando, pero si lo hace durante la ejecución, el componente devolverá MAV_RESULT_IN_PROGRESS con un progreso actualizado.</string>
    <string name="mav_result_command_long_only">El comando solo se acepta cuando se envía como un COMMAND_LONG.</string>
    <string name="mav_result_command_int_only">El comando solo se acepta cuando se envía como un COMMAND_INT.</string>
    <string name="mav_result_unknown">Desconocido</string>

