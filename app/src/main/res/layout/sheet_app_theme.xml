<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_home_sheet">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_home_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="@string/home_theme_sheet_title"
        android:textColor="?attr/deTextDim"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/theme_row_dark"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_theme_dark"
                android:textColor="?attr/deTextPrimary"
                android:textSize="16sp" />

            <View
                android:id="@+id/theme_dot_dark"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_home_status_dot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/theme_row_light"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_theme_light"
                android:textColor="?attr/deTextPrimary"
                android:textSize="16sp" />

            <View
                android:id="@+id/theme_dot_light"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_home_status_dot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/theme_row_sun"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_theme_sun"
                android:textColor="?attr/deTextPrimary"
                android:textSize="16sp" />

            <View
                android:id="@+id/theme_dot_sun"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_home_status_dot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/theme_row_system"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_theme_system"
                android:textColor="?attr/deTextPrimary"
                android:textSize="16sp" />

            <View
                android:id="@+id/theme_dot_system"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_home_status_dot" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
