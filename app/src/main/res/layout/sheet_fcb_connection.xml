<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_home_sheet">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_home_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/home_fcb_sheet_title"
        android:textColor="@color/home_text_dim"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Bluetooth -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/home_border_soft" />

            <LinearLayout
                android:id="@+id/fcb_sheet_row_bt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_fcb_bluetooth"
                    android:textColor="@color/home_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:id="@+id/fcb_sheet_dot_bt"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_home_status_dot" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fcb_sheet_group_bt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/fcb_sheet_btn_bt_toggle"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_home_bt_toggle_off"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/home_fcb_bt_off"
                        android:textColor="@color/home_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fcb_sheet_btn_bt_scan"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_scan_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/home_fcb_bt_scan"
                        android:textColor="@color/home_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ListView
                    android:id="@+id/fcb_sheet_list_bt"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_home_bt_list"
                    android:divider="@color/home_border_input"
                    android:dividerHeight="1dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- USB -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/home_border_soft" />

            <LinearLayout
                android:id="@+id/fcb_sheet_row_usb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_fcb_usb"
                    android:textColor="@color/home_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:id="@+id/fcb_sheet_dot_usb"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_home_status_dot" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fcb_sheet_group_usb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/home_fcb_baud_rate_label"
                    android:textColor="@color/home_text_dim"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/fcb_sheet_spinner_baud"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_home_input"
                    android:popupBackground="@color/home_popup_bg"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:id="@+id/fcb_sheet_txt_usb_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/home_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Wi-Fi / TCP-IP -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/home_border_soft" />

            <LinearLayout
                android:id="@+id/fcb_sheet_row_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_fcb_wifi"
                    android:textColor="@color/home_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:id="@+id/fcb_sheet_dot_wifi"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_home_status_dot" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fcb_sheet_group_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/home_fcb_hub_ip_label"
                        android:textColor="@color/home_text_dim"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/fcb_sheet_edt_hub_ip"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_home_input"
                        android:fontFamily="monospace"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/home_text_on_input"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/home_fcb_port_label"
                        android:textColor="@color/home_text_dim"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/fcb_sheet_edt_hub_port"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_home_input"
                        android:fontFamily="monospace"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/home_text_on_input"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- UDP Broadcast -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/home_border_soft" />

            <LinearLayout
                android:id="@+id/fcb_sheet_row_udp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_fcb_udp"
                    android:textColor="@color/home_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:id="@+id/fcb_sheet_dot_udp"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_home_status_dot" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fcb_sheet_group_udp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/home_fcb_local_ip_label"
                    android:textColor="@color/home_text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/fcb_sheet_txt_local_ip"
                    android:layout_width="180dp"
                    android:layout_height="38dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_home_input"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/home_text_on_input"
                    android:textSize="14sp"
                    tools:text="10.123.124.200" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/home_fcb_udp_port_label"
                    android:textColor="@color/home_text_dim"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/fcb_sheet_edt_udp_port"
                    android:layout_width="180dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_home_input"
                    android:fontFamily="monospace"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/home_text_on_input"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_fcb_udp_helper"
                    android:textColor="@color/home_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/fcb_sheet_btn_connect"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_home_btn_amber"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/home_btn_connect"
            android:textColor="@color/home_amber_on"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:id="@+id/fcb_sheet_btn_disconnect"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_home_btn_outline_red"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/home_btn_disconnect"
            android:textColor="@color/home_red_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
