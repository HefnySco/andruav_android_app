<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <!-- SMS Commands toggle - writes key_sms_rx_chk, same as Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_home_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_gr_sms_rx_chk"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/phone_sms_commands_hint"
                    android:textColor="@color/home_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/phone_sms_commands_toggle"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_home_bt_toggle_off"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/home_fcb_bt_off"
                android:textColor="@color/home_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ALLOWED CONTACTS card - same key_sms_rx_contacts CSV Settings edits -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_home_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/phone_sms_contacts_title"
                    android:textColor="@color/home_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.09" />

                <TextView
                    android:id="@+id/phone_sms_contacts_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/home_text_dim"
                    android:textSize="12sp"
                    tools:text="2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/phone_sms_contacts_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/phone_sms_btn_add_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingEnd="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/phone_sms_add_contact"
                android:textColor="@color/home_amber"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <!-- PIN + max age + keywords card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_home_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/phone_sms_pin_label"
                        android:textColor="@color/home_text_dim"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/phone_sms_pin_box"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_home_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp">

                        <EditText
                            android:id="@+id/phone_sms_pin"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="monospace"
                            android:inputType="numberPassword"
                            android:textColor="@color/home_text_on_input"
                            android:textSize="14sp"
                            android:hint="@string/phone_sms_pin_hint"
                            android:textColorHint="@color/home_text_dim_darker" />

                        <TextView
                            android:id="@+id/phone_sms_pin_show"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:paddingStart="10dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/phone_sms_pin_show"
                            android:textColor="@color/home_text_dim"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/phone_sms_age_label"
                        android:textColor="@color/home_text_dim"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_home_input">

                        <TextView
                            android:id="@+id/phone_sms_age_minus"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="−"
                            android:textColor="@color/home_amber"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/phone_sms_age_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:textColor="@color/home_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="120" />

                        <TextView
                            android:id="@+id/phone_sms_age_plus"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/home_amber"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/phone_sms_keywords_label"
                android:textColor="@color/home_text_dim"
                android:textSize="11sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/phone_sms_keywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- SMS Info card - writes key_sms_chk; the target number is
             key_mobile_recovery (tap it to change) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_home_card"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/phone_sms_info_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_gr_sms_chk"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/phone_sms_info_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/home_text_dim"
                    android:textSize="11sp"
                    tools:text="Emergency info SMS to +966 50 ···· 402" />
            </LinearLayout>

            <TextView
                android:id="@+id/phone_sms_info_toggle"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_home_bt_toggle_off"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/home_fcb_bt_off"
                android:textColor="@color/home_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/phone_sms_btn_dry_run"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_btn_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/phone_sms_dry_run"
            android:textColor="@color/home_amber"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/phone_sms_footer"
            android:textColor="@color/home_text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
