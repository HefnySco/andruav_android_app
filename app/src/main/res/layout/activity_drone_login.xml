<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="fill_parent"
android:layout_height="fill_parent"
android:background="@drawable/bg_main_gradient"
android:fillViewport="true"
android:clipToPadding="false"
tools:context=".activities.login.drone.MainDroneActiviy$DroneLoginShasha">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/header_logo_glow"
        android:padding="8dp"
        android:src="@drawable/ic_logo2"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="32dp"
        android:gravity="center_horizontal"
        android:text="@string/main_activity_header_title"
        android:textColor="@color/header_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06" />

    <TextView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_Title"
        android:id="@+id/droneloginactivity_txtTitle"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        android:padding="10dp"
        android:background="@drawable/section_header_bg"
        android:textColor="@color/chip_icon"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="@string/login_email"
        android:id="@+id/droneloginactivity_txtEmail"
        android:textColor="@color/chip_text"
        android:layout_marginBottom="6dp" />

    <EditText
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:inputType="textEmailAddress"
        android:ems="10"
        android:id="@+id/droneloginactivity_edtEmail"
        android:background="@drawable/chip_info_background"
        android:textColor="@color/chip_text"
        android:textColorHint="@color/header_subtitle"
        android:padding="14dp"
        android:autoText="false"
        android:layout_marginBottom="20dp"
        android:hint="email used to register your account" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="@string/login_access_code"
        android:id="@+id/droneloginactivity_txtAccessCode"
        android:textColor="@color/chip_text"
        android:layout_marginBottom="6dp" />

    <EditText
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword"
        android:ems="10"
        android:id="@+id/droneloginactivity_edtAccessCode"
        android:background="@drawable/chip_info_background"
        android:textColor="@color/chip_text"
        android:textColorHint="@color/header_subtitle"
        android:padding="14dp"
        android:autoText="false"
        android:layout_marginBottom="20dp"
        android:hint="access code received by email" />

    <Button
        android:layout_width="fill_parent"
        android:layout_height="52dp"
        android:text="@string/login_login"
        android:id="@+id/droneloginactivity_btnSaveAccessCode"
        android:textAllCaps="false"
        android:textColor="@color/sel_main_btn_text"
        android:gravity="center"
        android:drawablePadding="10dp"
        android:elevation="4dp"
        android:stateListAnimator="@null"
        android:background="@drawable/sel_big_button_color"
        android:drawableLeft="@drawable/login2_w_32x32"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/chip_border"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/droneloginactivity_txtSubscribe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="@string/hyper_subscribe"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@color/chip_icon" />

</LinearLayout></ScrollView>
