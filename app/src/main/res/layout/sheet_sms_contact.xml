<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_home_sheet">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_home_sheet_handle" />

    <TextView
        android:id="@+id/sms_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/sheet_sms_add_contact_title"
        android:textColor="?attr/deTextDim"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <LinearLayout
        android:id="@+id/sms_sheet_group_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/sms_sheet_lbl_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/sheet_sms_name_label"
            android:textColor="?attr/deTextDim"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/sms_sheet_edt_name"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_home_input"
            android:fontFamily="monospace"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/deTextOnInput"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sms_sheet_err_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sheet_sms_name_hint"
            android:textColor="?attr/deTextDimDarker"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sms_sheet_group_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/sheet_sms_number_label"
            android:textColor="?attr/deTextDim"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/sms_sheet_edt_number"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_home_input"
            android:fontFamily="monospace"
            android:inputType="phone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/deTextOnInput"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sms_sheet_err_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/deBadText"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Number too short. Use the full international form, e.g. +966551234567." />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/sms_sheet_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_home_btn_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/sheet_sms_cancel"
            android:textColor="?attr/deTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sms_sheet_btn_save"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_btn_amber"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/sheet_sms_save"
            android:textColor="?attr/deOnAccent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />
    </LinearLayout>

</LinearLayout>
