<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_home_sheet">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_home_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/home_hub_sheet_title"
        android:textColor="@color/home_text_dim"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Server IP -->
            <TextView
                android:id="@+id/hub_sheet_lbl_server_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/websocket_IP"
                android:textColor="@color/home_text_dim"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/hub_sheet_edt_server_ip"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_home_input"
                android:fontFamily="monospace"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/home_text_on_input"
                android:textColorHint="@color/home_text_dim"
                android:textSize="14sp" />

            <!-- Port -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/websocket_Port"
                android:textColor="@color/home_text_dim"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/hub_sheet_edt_server_port"
                android:layout_width="180dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_home_input"
                android:fontFamily="monospace"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/home_text_on_input"
                android:textColorHint="@color/home_text_dim"
                android:textSize="14sp" />

            <!-- Cloud server toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_hub_cloud_toggle_label"
                    android:textColor="@color/home_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/hub_sheet_btn_cloud_toggle"
                    android:layout_width="70dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_home_bt_toggle_off"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/home_fcb_bt_off"
                    android:textColor="@color/home_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/home_border_soft" />

            <!-- Unit ID / username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/websocket_UserName"
                android:textColor="@color/home_text_dim"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/hub_sheet_edt_username"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_home_input"
                android:hint="@string/hub_activity_usernameHint"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/home_text_on_input"
                android:textColorHint="@color/home_text_dim"
                android:textSize="14sp" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/websocket_Description"
                android:textColor="@color/home_text_dim"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/hub_sheet_edt_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"
                android:background="@drawable/bg_home_input"
                android:hint="@string/hub_activity_briefHint"
                android:inputType="textMultiLine"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/home_text_on_input"
                android:textColorHint="@color/home_text_dim"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/hub_sheet_btn_save"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_home_btn_amber"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/home_btn_save"
            android:textColor="@color/home_amber_on"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />
    </LinearLayout>

</LinearLayout>
