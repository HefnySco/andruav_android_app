<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/header_logo_glow"
                android:padding="7dp"
                android:src="@drawable/ic_logo2"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="14dp"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_activity_header_title"
                    android:textColor="@color/header_title"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/main_activity_tagline"
                    android:textColor="@color/header_subtitle"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action grid: row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnIMU"
                android:layout_width="0dp"
                android:layout_height="148dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:background="@drawable/sel_big_button_color"
                android:text="@string/main_activity_btn_IMU"
                android:textAllCaps="false"
                android:textColor="@color/sel_main_btn_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:drawableTop="@drawable/badge_icon_imu"
                android:drawablePadding="10dp"
                android:paddingTop="10dp" />

            <Button
                android:id="@+id/btnFPV"
                android:layout_width="0dp"
                android:layout_height="148dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:background="@drawable/sel_big_button_color"
                android:text="@string/main_activity_btn_FPV"
                android:textAllCaps="false"
                android:textColor="@color/sel_main_btn_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:drawableTop="@drawable/badge_icon_fpv"
                android:drawablePadding="10dp"
                android:paddingTop="10dp" />

        </LinearLayout>

        <!-- Action grid: row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCommServer"
                android:layout_width="0dp"
                android:layout_height="148dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:background="@drawable/sel_big_button_color"
                android:text="@string/main_activity_btn_COM"
                android:textAllCaps="false"
                android:textColor="@color/sel_main_btn_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:drawableTop="@drawable/badge_icon_com"
                android:drawablePadding="10dp"
                android:paddingTop="10dp" />

            <Button
                android:id="@+id/btnFCB"
                android:layout_width="0dp"
                android:layout_height="148dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:background="@drawable/sel_big_button_color"
                android:text="@string/main_activity_btn_FCB"
                android:textAllCaps="false"
                android:textColor="@color/sel_main_btn_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:drawableTop="@drawable/badge_icon_fcb"
                android:drawablePadding="10dp"
                android:paddingTop="10dp" />

        </LinearLayout>

        <!-- Info chips -->
        <TextView
            android:id="@+id/mainactivity_txtAccessCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/chip_info_background"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/chip_text"
            android:textSize="13sp"
            android:fontFamily="sans-serif-condensed"
            android:hint="@string/main_activity_hint_access"
            android:textColorHint="@color/header_subtitle" />

        <TextView
            android:id="@+id/mainactivity_txtUdpProxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/chip_info_background"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/chip_text"
            android:textSize="13sp"
            android:fontFamily="sans-serif-condensed"
            android:hint="@string/main_activity_hint_telem"
            android:textColorHint="@color/header_subtitle" />

    </LinearLayout>

</ScrollView>
