<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/bg_main_gradient"
    android:clipToPadding="false"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".activities.fcb.drone.FCB_AndruavShashaL2"
    tools:showIn="@layout/activity_fcb_drone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Connection type: smart tabs -->
        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Connection Type"
            android:textStyle="bold"
            android:textColor="@color/chip_icon"
            android:gravity="center_horizontal"
            android:padding="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/section_header_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:button="@null"
                android:gravity="center"
                android:background="@drawable/sel_segment_tab_bg"
                android:textColor="@color/sel_segment_tab_text"
                android:textSize="13sp"
                android:text="@string/fcbdrone_bt"
                android:id="@+id/fcbdroneactivity_dbBT" />

            <RadioButton
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:button="@null"
                android:gravity="center"
                android:background="@drawable/sel_segment_tab_bg"
                android:textColor="@color/sel_segment_tab_text"
                android:textSize="13sp"
                android:text="@string/fcbdrone_usb"
                android:id="@+id/fcbdroneactivity_rbUSB" />

            <RadioButton
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:button="@null"
                android:gravity="center"
                android:background="@drawable/sel_segment_tab_bg"
                android:textColor="@color/sel_segment_tab_text"
                android:textSize="13sp"
                android:text="@string/fcbdrone_tcp"
                android:id="@+id/fcbdroneactivity_rbTCP" />

            <RadioButton
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:background="@drawable/sel_segment_tab_bg"
                android:textColor="@color/sel_segment_tab_text"
                android:textSize="13sp"
                android:text="@string/fcbdrone_udp"
                android:id="@+id/fcbdroneactivity_rbUDP" />

        </LinearLayout>

        <!-- Bluetooth settings: shown only when Bluetooth tab is selected -->
        <LinearLayout
            android:id="@+id/fcbdroneactivity_sectionBT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device ID"
                android:textColor="@color/chip_text"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:id="@+id/fcbdroneactivity_edtBTID"
                android:textColor="@color/chip_text"
                android:background="@drawable/chip_info_background"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:editable="false"
                android:hint="click here" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan Bluetooth"
                android:id="@+id/fcbdroneactivity_txtBTSelect"
                android:textColor="@color/chip_icon"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/fcbdroneactivity_bluetoothList"
                android:layout_width="fill_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/chip_info_background"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- TCP settings: shown only when TCP tab is selected -->
        <LinearLayout
            android:id="@+id/fcbdroneactivity_sectionTCP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/websocket_IP"
                android:textColor="@color/chip_text"
                android:layout_marginBottom="6dp" />

            <EditText
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:ems="10"
                android:id="@+id/fcbdroneactivity_edtTCPServerIP"
                android:background="@drawable/chip_info_background"
                android:textColor="@color/chip_text"
                android:textColorHint="@color/header_subtitle"
                android:padding="12dp"
                android:layout_marginBottom="18dp"
                android:hint="@string/hub_activity_usernameHint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Port"
                android:textColor="@color/chip_text"
                android:layout_marginBottom="6dp" />

            <EditText
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:inputType="text|number"
                android:ems="10"
                android:id="@+id/fcbdroneactivity_edtTCPPort"
                android:background="@drawable/chip_info_background"
                android:textColor="@color/chip_text"
                android:textColorHint="@color/header_subtitle"
                android:padding="12dp"
                android:textSize="16sp"
                android:hint="@string/hub_activity_usernameHint" />

        </LinearLayout>

        <!-- UDP settings: shown only when UDP tab is selected -->
        <LinearLayout
            android:id="@+id/fcbdroneactivity_sectionUDP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/fcbdroneactivity_txtLocalIP"
                android:text="Local IP"
                android:textColor="@color/chip_text"
                android:layout_marginBottom="6dp" />

            <EditText
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:id="@+id/fcbdroneactivity_edtLocalIP"
                android:background="@drawable/chip_info_background"
                android:textColor="@color/chip_text"
                android:textColorHint="@color/header_subtitle"
                android:padding="12dp"
                android:layout_marginBottom="18dp"
                android:hint="@string/fcbdroneactivity_edtLocalIP"
                android:inputType="number"
                android:editable="false"
                android:enabled="true"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UDP Port"
                android:id="@+id/fcbdroneactivity_txtUDPPort"
                android:textColor="@color/chip_text"
                android:layout_marginBottom="6dp" />

            <EditText
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:id="@+id/fcbdroneactivity_edtUDPPort"
                android:background="@drawable/chip_info_background"
                android:textColor="@color/chip_text"
                android:textColorHint="@color/header_subtitle"
                android:padding="12dp"
                android:textSize="16sp"
                android:hint="@string/fcbdroneactivity_edtUDPPort"
                android:inputType="number" />

        </LinearLayout>

        <!-- USB settings: shown only when USB tab is selected -->
        <LinearLayout
            android:id="@+id/fcbdroneactivity_sectionUSB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fcbdrone_usbbaudrate"
                android:id="@+id/fcbdronactivity_txtUSBBaudRate"
                android:textColor="@color/chip_text"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:id="@+id/fcbdroneactivity_lbUSBBaudRate"
                android:background="@drawable/chip_info_background"
                android:popupBackground="@color/card_surface_light"
                android:spinnerMode="dialog" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/chip_border"
            android:layout_marginBottom="24dp" />

        <!-- Mav Vehicle ID: always visible, informational -->
        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Mav Vehicle ID"
            android:textStyle="bold"
            android:textColor="@color/chip_icon"
            android:gravity="center_horizontal"
            android:padding="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/section_header_bg" />

        <TextView
            android:id="@+id/fcbdroneactivity_txtSysID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID"
            android:textColor="@color/chip_text"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/fcbdroneactivity_edtSysID"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_info_background"
            android:clickable="false"
            android:ems="10"
            android:enabled="true"
            android:focusable="false"
            android:inputType="number"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="@color/chip_text" />

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fcbdrone_3dr"
                android:id="@+id/fcbdroneactivity_rb3DR"
                android:textColor="@color/chip_text" />

        </RadioGroup>

    </LinearLayout>
</ScrollView>
