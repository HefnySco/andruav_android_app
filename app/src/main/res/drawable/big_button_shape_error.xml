<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/btn_TXT_WHITE">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle" >
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF7A6E"
                android:endColor="@color/btn_TXT_ERROR" />
            <stroke
                android:width="1.5dp"
                android:color="@color/btn_TXT_ERROR" />
        </shape>
    </item>
</ripple>
