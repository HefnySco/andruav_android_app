<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/disabled_surface" />
            <stroke android:width="1dp" android:color="@color/disabled_stroke" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/chip_icon"
                android:endColor="@color/accent_com_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/chip_bg" />
            <stroke android:width="1dp" android:color="@color/chip_border" />
        </shape>
    </item>
</selector>
